# Copy to .env and adjust. Real environment variables take precedence over this file.

# App
APP_NAME="Backend Template"
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:3000"]
RUN_MIGRATIONS_ON_STARTUP=true

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=mypass
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_EXCHANGE_NAME=taskiq_exchange
RABBITMQ_QUEUE_NAME=taskiq_queue

# Task queue: "true" = in-memory broker (no RabbitMQ/Redis), "false" = RabbitMQ + Redis
TASK_QUEUE_USE_IN_MEMORY_BROKER=true

# OpenTelemetry: traces -> Tempo, metrics -> Mimir/Prometheus (PromQL), logs -> Loki
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend-template
# OTEL_SERVICE_NAMESPACE=myteam
OTEL_LOG_LEVEL=INFO
# true = print spans to stdout instead of exporting (no collector needed)
OTEL_CONSOLE_EXPORTER=false

# Local: `just otel` runs grafana/otel-lgtm, Grafana at http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Grafana Cloud: stack -> Details -> OpenTelemetry. The token needs metrics/logs/traces write.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>

# Optional
# OTEL_RESOURCE_ATTRIBUTES=k8s.cluster.name=prod,cloud.region=us-central1
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
