# Application
APP_NAME=Backend Template
DEBUG=true
ENVIRONMENT=development
RUN_MIGRATIONS_ON_STARTUP=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
DATABASE_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=mypass
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_EXCHANGE_NAME=taskiq_exchange
RABBITMQ_QUEUE_NAME=taskiq_queue

# Task Queue
# Set to "true" for development with in-memory broker (no RabbitMQ/Redis needed)
# Set to "false" for production with RabbitMQ and Redis
TASK_QUEUE_USE_IN_MEMORY_BROKER=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
